# Leave blank in Expo Go to use the API proxy on the Expo server automatically.
# Start-All.ps1 supplies the server-only upstream for web and mobile.
# EXPO_PUBLIC_* values are public; never put passwords or secret keys here.
EXPO_PUBLIC_API_BASE_URL=

# Expo web uses the Metro API/upload proxy on the same origin.
EXPO_PUBLIC_WEB_API_BASE_URL=/api
# Server-only upstream. No private API credentials belong in client variables.
API_PROXY_TARGET=https://localhost:7226

# If the backend uses its HTTP-only profile, change the server-only upstream:
# API_PROXY_TARGET=http://127.0.0.1:5027

# Android emulator without Expo host detection:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5027/api

# For a hosted backend, set its public HTTPS URL here:
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api
