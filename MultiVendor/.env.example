# Leave blank for web host detection / Android emulator defaults.
# Start-All.ps1 automatically supplies the shared API for web and mobile.
# EXPO_PUBLIC_* values are public; never put passwords or secret keys here.
EXPO_PUBLIC_API_BASE_URL=

# Expo web uses the Metro API/upload proxy on the same origin.
EXPO_PUBLIC_WEB_API_BASE_URL=/api
# Server-only upstream. No private API credentials belong in client variables.
API_PROXY_TARGET=http://127.0.0.1:5027

# Neu backend chi chay HTTPS tren cong 7226, dung:
# EXPO_PUBLIC_API_BASE_URL=https://localhost:7226/api

# Neu chay Android emulator, sao chep file nay thanh .env va dung:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5027/api

# Real phone on the same LAN: set the development PC's current IP.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.72:5027/api
